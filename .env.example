# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Selects the pipeline driver: "adk" runs the Google ADK workflow, "sdk" the straight-line pipeline; unset uses the built-in default (adk).
SILKSCREEN_ENGINE=
# Default-off gate for Ollama/Tinker/hybrid placement policies and trace capture.
SILKSCREEN_EXPERIMENTAL_PLACEMENT=0
OLLAMA_PLACEMENT_URL=
OLLAMA_PLACEMENT_MODEL=gemma3:4b
TINKER_API_KEY=
# Promoted sampler checkpoint only, for example tinker://...; never a base model.
TINKER_PLACEMENT_MODEL=
# Defaults to artifacts/placement-failure-traces.jsonl outside Cloud/Firestore.
PLACEMENT_FAILURE_TRACE_PATH=
# Root of the built web bundle; defaults to <repo>/frontend/dist, /app/frontend/dist in the container.
SILKSCREEN_WEB_DIST=
