# Copy to .env and fill in. Never commit .env.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Selects the pipeline driver: "adk" runs the Google ADK workflow, "sdk" the straight-line pipeline; unset uses the built-in default (adk).
SILKSCREEN_ENGINE=
# Ollama/Tinker/hybrid appear only after the user opts in from the interface.
OLLAMA_PLACEMENT_URL=
OLLAMA_PLACEMENT_MODEL=gemma3:4b
TINKER_API_KEY=
# Promoted sampler checkpoint only, for example tinker://...; never a base model.
TINKER_PLACEMENT_MODEL=
# Defaults to artifacts/placement-failure-traces.jsonl outside Cloud/Firestore.
PLACEMENT_FAILURE_TRACE_PATH=
# Root of the built web bundle; defaults to <repo>/frontend/dist, /app/frontend/dist in the container.
SILKSCREEN_WEB_DIST=

# --- Slack bot (slackbot/), only needed to run `python -m slackbot` ---
# Bot User OAuth Token from OAuth & Permissions, after installing the app.
SLACK_BOT_TOKEN=
# Basic Information -> Signing Secret. Every request is verified against this.
SLACK_SIGNING_SECRET=
# Port the bot listens on (Slack must be able to reach it). Default 3000.
SILKSCREEN_SLACK_PORT=3000
# Comma-separated channel IDs the bot will answer in. Empty means any channel
# it has been invited to.
SILKSCREEN_SLACK_CHANNELS=
# Concurrent design runs. Each costs model calls and a CP-SAT solve.
SILKSCREEN_SLACK_MAX_RUNS=2
# Placement solver budget per run, in seconds.
SILKSCREEN_SLACK_TIME_LIMIT=20
# Where each run's artifacts are written.
SILKSCREEN_SLACK_WORKDIR=slack-runs

# --- Google Workspace (googleapps/), only needed for `python -m googleapps` ---
# OAuth 2.0 client of type "Desktop app" (APIs & Services -> Credentials).
# Needed for Gmail and Calendar; the Chat webhook works without it.
GOOGLEAPPS_CLIENT_ID=
GOOGLEAPPS_CLIENT_SECRET=
# Incoming-webhook URL of the Chat space (Space settings -> Apps & integrations
# -> Webhooks). The URL is the credential: never commit or print it.
GOOGLEAPPS_CHAT_WEBHOOK=
# Where the OAuth token is stored (mode 0600). Default shown.
GOOGLEAPPS_TOKEN_PATH=~/.config/silkscreen/google-token.json
